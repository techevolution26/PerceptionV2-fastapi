APP_NAME=Perception API
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=perception-api
JWT_AUDIENCE=perception-client
DATABASE_URL=postgresql+asyncpg://perception:perception@postgres:5432/perception
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:8000

# Stripe Billing
# Use Stripe Dashboard Price IDs for the matching recurring plans.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_RESEARCH=price_...
STRIPE_PRICE_BUSINESS=price_...
# These are hosted Checkout return URLs; use HTTPS in production.
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PAST_DUE_GRACE_DAYS=0
# Google native OAuth (comma-separated Android/iOS client IDs)
GOOGLE_CLIENT_IDS=1007733623814-budt6fk7uf90lhj4ihmras7olgobdkd4.apps.googleusercontent.com,1007733623814-f642ptk0pb4qehio02evlkrqtc3icj5m.apps.googleusercontent.com
# Auth hardening
ADMIN_SESSION_EXPIRE_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=8
ADMIN_SESSION_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_FAIL_OPEN=false

# --- Account recovery ---
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
# Web: https://app.example.com/reset-password
# Native: perception://reset-password
PASSWORD_RESET_URL=http://localhost:3000/reset-password
MAIL_FROM=no-reply@perception.local
# SMTP is required in production. Leave blank for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Comment Intelligence ---
COMMENT_INTELLIGENCE_ENABLED=false
COMMENT_INTELLIGENCE_MODEL=gpt-5.6-luna
COMMENT_INTELLIGENCE_BATCH_SIZE=10
COMMENT_INTELLIGENCE_INTERVAL_SECONDS=60
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
